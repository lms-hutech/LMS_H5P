# H5P LTI Server Configuration
# Copy this file to .env and fill in your values

# =====================================================
# H5P Server
# =====================================================
# Public URL of the H5P server (accessible from browser AND Canvas server)
H5P_PUBLIC_URL=http://localhost:8080

# Server port
PORT=8080

# =====================================================
# Canvas LMS
# =====================================================
# Canvas LMS URL
PLATFORM_URL=http://172.22.250.207:3000

# Canvas Developer Key Client ID
LTI_CLIENT_ID=10000000000001

# Optional: Canvas issuer (leave empty to use PLATFORM_URL)
CANVAS_ISSUER=

# =====================================================
# LTI Security
# =====================================================
# Secret key for LTI session signing - CHANGE THIS IN PRODUCTION!
LTI_KEY=h5p-lti-dev-key-change-in-prod

# =====================================================
# MongoDB
# =====================================================
MONGODB_URI=mongodb://mongodb:27017/h5p-lti

# =====================================================
# MinIO (S3-compatible storage)
# =====================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# =====================================================
# Node environment
# =====================================================
NODE_ENV=production
