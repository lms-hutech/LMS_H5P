# === Server ===
PORT=8080
NODE_ENV=development

# === H5P Public URL (required in production) ===
# The publicly accessible URL of this server
H5P_PUBLIC_URL=https://your-domain.com

# === MongoDB (required for LTI) ===
MONGODB_URI=mongodb://localhost:27017/h5p-lti

# === LTI 1.3 Configuration ===
# Secret key for LTI token encryption (required in production)
LTI_KEY=
# Canvas Developer Key client ID (required for LTI)
LTI_CLIENT_ID=

# === Canvas Platform ===
# Canvas instance URL
PLATFORM_URL=https://canvas.yourdomain.com
# Canvas issuer URL (defaults to PLATFORM_URL if not set)
# CANVAS_ISSUER=
# Canvas API token for quiz-bank publishing features
# CANVAS_API_TOKEN=
# Gemini key for AI-assisted content generation
# GEMINI_API_KEY=
# Groq key for alternative AI generation flows
# GROQ_API_KEY=

# === Optional Google Drive Picker credentials ===
# Configure only if you use the bundled Google Drive video picker page
# GOOGLE_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_APP_ID=

# === Storage (optional, defaults to filesystem) ===
# CONTENTSTORAGE=mongos3
# LIBRARYSTORAGE=mongo
# TEMPORARYSTORAGE=s3

# === Caching (optional) ===
# CACHE=in-memory
# CACHE=redis

# === Debug (optional) ===
# DEBUG=i18n
# TEMP_UPLOADS=true
